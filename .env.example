# Tec Tha Vital - settings. Copy to .env (Docker) or /etc/tectha-care/env (systemd)
# and fill in real values. NEVER commit the real file; .env is in .gitignore.
# Make a random secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Core ---
# SQLite file. Docker and the systemd unit set this themselves; only needed for a manual run.
# TT_DB_PATH=data/tectha.db
# Signs staff login cookies. At least 32 characters or the app refuses to start.
# Set it on servers: the systemd unit keeps /opt read-only, so the app cannot create its own
# fallback file (data/.session_secret) there. Changing it logs everyone out.
TT_SESSION_SECRET=CHANGE-ME-run-the-command-above
# Key for /api and /webhooks/missed-call (billing software, website forms). API is off while empty.
TT_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
# simulator = nothing is sent, messages show on the Messages screen. live = real WhatsApp.
TT_WHATSAPP_MODE=simulator
# Use a System User token from the hospital's own Meta Business account (the 24-hour
# "temporary" token from the dashboard expires; see docs/RUNBOOK.md).
TT_WHATSAPP_TOKEN=
TT_WHATSAPP_PHONE_ID=
# Meta App > Settings > Basic > App secret. Verifies incoming webhooks. Required in live mode.
TT_WHATSAPP_APP_SECRET=
# Any string you choose; type the same one in Meta's webhook settings.
TT_WHATSAPP_VERIFY_TOKEN=replace-with-a-random-value

# --- Hospital details ---
# Owner's WhatsApp number for the 9 am report, as 91XXXXXXXXXX.
TT_OWNER_PHONE=919900000000
TT_PAYMENT_LINK_BASE=https://pay.example.in/your-hospital
TT_REVIEW_LINK=https://g.page/r/your-hospital/review

# --- Automations ---
TT_SCHEDULER=on
TT_SCHEDULER_INTERVAL=60

# --- AI (off by default) ---
TT_AI=off
# ANTHROPIC_API_KEY=
# TT_AI_MODEL=

# --- HTTPS with Caddy (docker compose --profile https) ---
TT_DOMAIN=care.yourhospital.in

# --- Backups (deploy/backup.sh) ---
# TT_BACKUP_DIR=/var/backups/tectha-care
# TT_BACKUP_KEEP_DAYS=30
# Encrypt backups with age before they leave the server (public key, safe to store here):
# TT_BACKUP_AGE_RECIPIENT=age1...
# Copy each backup off the server with rclone (configure the remote first):
# TT_BACKUP_RCLONE_REMOTE=gdrive:tectha-backups
# Free uptime ping, e.g. a healthchecks.io check URL:
# TT_HEALTHCHECK_PING_URL=
